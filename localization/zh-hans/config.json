    "code",
    "pre",
    "kbd",
    "samp",
    "textarea",
    "input",
    "select",
    "option",
    "script",
    "style",
    "[contenteditable]",
    "[data-testid=\"composer-editor\"]",
    "[role=\"code\"]",
    "[role=\"textbox\"]",
    "[role=\"log\"]",
    ".whitespace-pre-wrap",
    "[class*=\"xterm\"]"
  ],
